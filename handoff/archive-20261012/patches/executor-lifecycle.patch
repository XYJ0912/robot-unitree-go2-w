+    #[tokio::test]
+    async fn admission_registration_and_drain_share_the_lifecycle_boundary() {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let addr = listener.local_addr().unwrap();
+        drop(listener);
+        let server = tokio::spawn(serve_atlas(Arc::new(AtlasRegistry::default()), addr));
+        let mut atlas = AtlasClient::connect_with_retry(
+            format!("http://{addr}"),
+            50,
+            Duration::from_millis(10),
+        )
+        .await
+        .unwrap();
+        atlas
+            .register_service("executor", "robonix/system/executor", "")
+            .await
+            .unwrap();
+        atlas
+            .declare_capability(
+                "executor",
+                SHARED_DRIVER_CONTRACT,
+                robonix_atlas::pb::Transport::Grpc,
+                "127.0.0.1:50061",
+                robonix_atlas::client::grpc_params(
+                    "capabilities/lifecycle/driver.v1.toml",
+                    "robonix.contracts.RobonixLifecycleDriver",
+                    "/robonix.contracts.RobonixLifecycleDriver/Driver",
+                ),
+            )
+            .await
+            .unwrap();
+        let runtime = PlanRuntime::default();
+        let gate = LifecycleGate::new(atlas, "executor".into(), runtime.clone());
+        let plan = Plan {
+            plan_id: "p".into(),
+            ..Default::default()
+        };
+        assert_eq!(
+            gate.admit_plan(&plan).await.unwrap_err().code(),
+            tonic::Code::FailedPrecondition
+        );
+        assert!(gate.transition(CMD_ACTIVATE).await.is_err());
+        gate.transition(CMD_INIT).await.unwrap();
+        gate.transition(CMD_ACTIVATE).await.unwrap();
+        gate.admit_plan(&plan).await.unwrap();
+        assert_eq!(
+            gate.admit_plan(&plan).await.unwrap_err().code(),
+            tonic::Code::AlreadyExists
+        );
+        assert!(gate.transition(CMD_INIT).await.is_err());
+        assert!(!runtime.is_cancelled("p").await);
+        let draining = tokio::spawn({
+            let gate = gate.clone();
+            async move { gate.transition(CMD_DEACTIVATE).await }
+        });
+        tokio::time::timeout(Duration::from_secs(1), async {
+            while !runtime.is_cancelled("p").await {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        assert!(
+            gate.admit_plan(&Plan {
+                plan_id: "late".into(),
+                ..Default::default()
+            })
+            .await
+            .is_err()
+        );
+        assert!(!draining.is_finished());
+        runtime.complete_plan("p").await;
+        assert_eq!(draining.await.unwrap().unwrap(), "inactive");
+        assert!(runtime.is_empty().await);
+        assert!(gate.transition(99).await.is_err());
+        gate.transition(CMD_DEACTIVATE).await.unwrap();
+        gate.transition(CMD_ACTIVATE).await.unwrap();
+        gate.transition(CMD_SHUTDOWN).await.unwrap();
+        gate.transition(CMD_SHUTDOWN).await.unwrap();
+        assert!(*gate.subscribe_shutdown().borrow());
+        assert!(gate.transition(CMD_ACTIVATE).await.is_err());
+        server.abort();
+    }
+}
