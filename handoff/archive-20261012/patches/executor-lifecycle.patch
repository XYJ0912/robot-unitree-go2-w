+++ b/system/executor/src/lifecycle.rs
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: MulanPSL-2.0
+use crate::pb::contracts::robonix_lifecycle_driver_server::RobonixLifecycleDriver;
+use crate::pb::lifecycle::{DriverRequest, DriverResponse};
+use crate::pb::pilot::Plan;
+use crate::plan_runtime::PlanRuntime;
+use anyhow::{Context, Result, bail};
+use robonix_atlas::client::AtlasClient;
+use robonix_atlas::pb::LifecycleState;
+use robonix_scribe::{info, warn};
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::{Mutex, watch};
+use tonic::{Request, Response, Status};
+
+pub const SHARED_DRIVER_CONTRACT: &str = "robonix/lifecycle/driver";
+pub const CMD_INIT: u32 = 0;
+pub const CMD_ACTIVATE: u32 = 1;
+pub const CMD_DEACTIVATE: u32 = 2;
+pub const CMD_SHUTDOWN: u32 = 3;
+const DRAIN_TIMEOUT: Duration = Duration::from_secs(5);
+
+struct Admission {
+    state: LifecycleState,
+    accepting: bool,
+}
+
+#[derive(Clone)]
+pub struct LifecycleGate {
+    atlas: AtlasClient,
+    provider_id: String,
+    runtime: PlanRuntime,
+    admission: Arc<Mutex<Admission>>,
+    commands: Arc<Mutex<()>>,
+    shutdown_tx: watch::Sender<bool>,
+}
+
+impl LifecycleGate {
+    pub fn new(atlas: AtlasClient, provider_id: String, runtime: PlanRuntime) -> Self {
+        let (shutdown_tx, _) = watch::channel(false);
+        Self {
+            atlas,
+            provider_id,
+            runtime,
+            admission: Arc::new(Mutex::new(Admission {
+                state: LifecycleState::StateRegistered,
+                accepting: false,
+            })),
+            commands: Arc::new(Mutex::new(())),
+            shutdown_tx,
+        }
+    }
+
+    pub fn subscribe_shutdown(&self) -> watch::Receiver<bool> {
+        self.shutdown_tx.subscribe()
+    }
+
+    pub async fn admit_plan(&self, plan: &Plan) -> Result<(), Status> {
+        // Admission and registration must precede the drain snapshot together.
+        let admission = self.admission.lock().await;
+        if !admission.accepting {
+            return Err(Status::failed_precondition(
+                "Executor is not accepting plans",
+            ));
+        }
+        if !self.runtime.register_plan(&plan.plan_id).await {
+            return Err(Status::already_exists("RTDL plan is already active"));
+        }
+        self.runtime.record_plan_ops(plan).await;
+        Ok(())
+    }
+
+    async fn transition(&self, command: u32) -> Result<&'static str> {
+        use LifecycleState::*;
+        let _serial = self.commands.lock().await;
+        let mut admission = self.admission.lock().await;
+        let state = admission.state;
+        let (target, label) = match command {
+            CMD_INIT if matches!(state, StateRegistered | StateInactive | StateError) => {
+                (StateInactive, "inactive")
+            }
+            CMD_ACTIVATE if matches!(state, StateInactive | StateActive) => (StateActive, "active"),
+            CMD_DEACTIVATE if matches!(state, StateInactive | StateActive) => {
+                (StateInactive, "inactive")
+            }
+            CMD_SHUTDOWN => (StateTerminated, "terminated"),
+            CMD_INIT | CMD_ACTIVATE | CMD_DEACTIVATE => {
+                bail!("lifecycle command {command} is invalid in {state:?}")
+            }
+            _ => bail!("unknown lifecycle command {command}"),
+        };
+        if command == CMD_ACTIVATE && !admission.accepting && !self.runtime.is_empty().await {
+            bail!("Executor still has plans draining; retry after they finish")
+        }
+        admission.accepting = false;
+        drop(admission);
+
+        if command != CMD_ACTIVATE {
+            let mut atlas = self.atlas.clone();
+            self.runtime
+                .drain_for_lifecycle(&self.provider_id, &mut atlas)
+                .await?;
+        }
+
+        let mut atlas = self.atlas.clone();
+        tokio::time::timeout(
+            DRAIN_TIMEOUT,
+            atlas.set_lifecycle_state(&self.provider_id, target, ""),
+        )
+        .await
+        .context("publish Executor lifecycle state timed out")??;
+        let mut admission = self.admission.lock().await;
+        admission.state = target;
+        admission.accepting = command == CMD_ACTIVATE;
+        if command == CMD_SHUTDOWN {
+            self.shutdown_tx.send_replace(true);
+        }
+        info!("[executor/lifecycle] command {command} -> {label}");
+        Ok(label)
+    }
+}
+
+#[tonic::async_trait]
+impl RobonixLifecycleDriver for LifecycleGate {
+    async fn driver(
+        &self,
+        request: Request<DriverRequest>,
+    ) -> Result<Response<DriverResponse>, Status> {
+        let command = request.into_inner().command;
+        let response = match self.transition(command).await {
+            Ok(state) => DriverResponse {
+                ok: true,
+                state: state.into(),
+                error: String::new(),
+            },
+            Err(error) => {
+                warn!("[executor/lifecycle] command {command} failed: {error:#}");
+                DriverResponse {
+                    ok: false,
+                    state: "error".into(),
+                    error: format!("{error:#}"),
+                }
+            }
+        };
+        Ok(Response::new(response))
+    }
+}
+
+pub async fn wait_for_driver_shutdown(mut shutdown: watch::Receiver<bool>) {
+    if *shutdown.borrow() {
+        return;
+    }
+    while shutdown.changed().await.is_ok() {
+        if *shutdown.borrow() {
+            return;
+        }
+    }
+}
