+async fn initialize_driver(advertised: &str) -> Result<()> {
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(5);
+    let mut client = loop {
+        match tokio::time::timeout_at(
+            deadline,
+            RobonixLifecycleDriverClient::connect(format!("http://{advertised}")),
+        )
+        .await
+        {
+            Ok(Ok(client)) => break client,
+            Ok(Err(_)) if tokio::time::Instant::now() < deadline => {
+                tokio::time::sleep(Duration::from_millis(25)).await;
+            }
+            _ => anyhow::bail!("connect startup lifecycle Driver timed out"),
+        }
+    };
+    for command in [CMD_INIT, CMD_ACTIVATE] {
+        let mut request = tonic::Request::new(DriverRequest {
+            command,
+            config_json: "{}".into(),
+        });
+        request.set_timeout(Duration::from_secs(12));
+        let response = client
+            .driver(request)
+            .await
+            .context("call startup lifecycle Driver")?
+            .into_inner();
+        if !response.ok {
+            anyhow::bail!("startup lifecycle Driver failed: {}", response.error);
+        }
+    }
     Ok(())
 }
